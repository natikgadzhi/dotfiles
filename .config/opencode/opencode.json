{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (MLX)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "qwen/qwen3.6-27b": {
          "tools": true
        }
      }
    }
  },
  "model": "openrouter/qwen/qwen3.7-max",
  "instructions": [
    "~/.claude/profile.local.md",
    "~/.claude/writing-style.local.md"
  ],
  "permission": {
    "bash": {
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "git push *": "ask",
      "git commit *": "ask",
      "git rebase *": "ask",
      "git merge *": "ask",
      "npm publish *": "ask",
      "gh release *": "ask",
      "kubectl delete *": "ask",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git clean -f *": "deny",
      "sudo *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "chmod -R *": "deny",
      "terraform destroy *": "deny",
      "pulumi destroy *": "deny"
    },
    "external_directory": {
      "*": "deny",
      "~/.config/opencode/**": "allow",
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/src/natikgadzhi/dotfiles/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  },
  "plugin": [
    "cc-safety-net@latest",
    "/Users/natik.gadzhi/.config/opencode/vendor/i-have-adhd/.opencode/plugins/i-have-adhd.mjs"
  ]
}
