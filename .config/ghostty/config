
# Keybinds
#
keybind = ctrl+z=close_surface
keybind = shift+ctrl+d=new_split:right
# NOTE: not shift+ctrl+v — that is the paste binding on Linux, and overriding
# it silently breaks paste there. Harmless on macOS, where paste is super+v.
keybind = shift+ctrl+e=new_split:down
keybind = global:ctrl+`=toggle_quick_terminal
keybind = shift+ctrl+.=reload_config

# `super` is Command on macOS and the Super/Win key on Linux, so these bind
# correctly on both. `cmd` is macOS-only and is inert on Linux.
keybind = super+shift+w=close_window
keybind = super+v=paste_from_clipboard
keybind = super+c=copy_to_clipboard

keybind = shift+enter=text:\n

# Copy on select, matching tmux behavior
copy-on-select = clipboard

# Visual font, theme, cursors
#
# Family name in font-family, style name in font-style-*. macOS CoreText will
# match a full name like "JetBrains Mono Italic", but fontconfig matches family
# names only and silently falls back to Noto Sans, so keep the two separate.
font-family = "JetBrains Mono"
font-size = 16
font-feature = "liga"

font-style-bold = "SemiBold"
font-style-italic = "Italic"
font-style-bold-italic = "SemiBold Italic"

# Optional: Adjust spacing for a more comfortable look
adjust-cell-height = 1.5%
# font-thicken = true

# Dracula (built-in), matching opencode's `dracula` theme exactly — background
# #282a36, purple accents #bd93f9. opencode's theme is picked in the TUI and
# persisted in ~/.local/state/opencode/kv.json, not its config file. The old
# local `opencode` theme is still in themes/ if we ever go back.
theme = Dracula
cursor-style = block

initial-window = false


# Shell and OS integration
#
term=xterm-256color

# Fish is set as system shell so the config is portable
# command = /opt/homebrew/bin/fish --login --interactive
shell-integration = fish
shell-integration-features = cursor, sudo, title, ssh-env, ssh-terminfo

# Decoration was broken on MacOS 26
macos-titlebar-style = tabs
# window-decoration = false
window-theme = system
macos-option-as-alt = true
macos-non-native-fullscreen = true

# YOLO updates
auto-update-channel = tip


# Don't show a dialog when I'm slamming cmd+q
#
confirm-close-surface = false

# Auto-update settings
#
auto-update = download


# Quick Terminal
#
quick-terminal-animation-duration = 0
quick-terminal-position = center
quick-terminal-autohide = true
quick-terminal-size = 50%
quick-terminal-screen = main
