.aws/
.boto
.bundle/
.docker/
.ipython/
.jupyter/
.DS_Store
.vim/plugged
.vim/.netrwhist

# iTerm2 makes sockets and puts them in it's config path
.config/iterm2/AppSupport

.config/fish/fish_variables

# Compiled nvim plugin bundle
.config/nvim/plugin/packer_compiled.lua

# Zed makes temp files
.config/zed/.tmp*
.config/zed/embeddings
.config/zed/conversations
.config/zed/settings_backup.json

# Too noisy
.tmux-status.conf
.wget-hsts
.htoprc

# Tide shites all over this file frequently, no need to save it then.
.config/fish/fishd*

# Yarnrc is mostly useless to me
.yarnrc

# These might contain credentials or tokens:
.netrc
.config/hub
.ngrok2
.kube
.local/share/opencode/auth.json

# nvim undo and tem files
undodir

# no need to sync log files
**/*.log
.config/zed/prompts

# Machine-local fish state. fish rewrites this file in place, and because
# ~/.config/fish is a symlinked directory those writes land in this repo —
# which synced Homebrew paths onto Linux. Prompt config lives in conf.d/pure.fish.
.config/fish/fish_variables
# ...and the backups left behind when that file gets repaired.
.config/fish/*.bak

# tpm clones plugins next to the tmux config, and ~/.config/tmux is symlinked
# here too, so they land in this repo. They are upstream checkouts pinned by
# tmux.conf's @plugin lines — reinstall with prefix+I, don't vendor them.
.config/tmux/plugins/

# Machine-local git overrides (editor, credential helper).
.gitconfig.local
